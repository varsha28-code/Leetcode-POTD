class Solution(object):
    def leftRightDifference(self, nums):
        n = len(nums)
        answer = [0] * n
        total_sum = sum(nums)
        left_sum = 0
        for i in range(n):
            total_sum -= nums[i]  # right sum
            answer[i] = abs(left_sum - total_sum)
            left_sum += nums[i]
        return answer
        
